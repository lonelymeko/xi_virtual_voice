# 环境变量配置模板

# 阿里云 DashScope API 密钥
# 获取地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your_api_key_here

# 通义千问语音模型（可选，默认: qwen-audio-turbo）
QWEN_VOICE_MODEL=qwen-audio-turbo

# DashScope API 端点（可选，默认使用阿里云官方端点）
DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2speech/speech-synthesis

# WebSocket 服务器配置（可选）
# 主机地址（默认: localhost）
WS_HOST=localhost

# WebSocket 端口号（默认: 7878）
WS_PORT=7878

# WebSocket 路径（默认: /ws）
WS_PATH=/ws

# HTTP API 服务器配置（可选）
# HTTP 端口号（默认: 9091）
HTTP_PORT=9091

# HTTP API 路径（默认: /api/tts）
HTTP_PATH=/api/tts
